; NSIS template filled by tools/native_installers.py (adapted from GUI.Forms packaging/windows_installer.nsi.in). Placeholders: @NAME@
Unicode True
!include "MUI2.nsh"
Name "@DISPLAY_NAME@"
OutFile "@OUTFILE@"
InstallDir "@INSTALL_DIR@"
RequestExecutionLevel user
VIProductVersion "@VERSION4@"
VIAddVersionKey "ProductName" "@DISPLAY_NAME@"
VIAddVersionKey "ProductVersion" "@VERSION@"
VIAddVersionKey "CompanyName" "@VENDOR@"
VIAddVersionKey "FileDescription" "@DISPLAY_NAME@ installer"
VIAddVersionKey "FileVersion" "@VERSION@"
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Section "@DISPLAY_NAME@"
  SetOutPath "$INSTDIR"
  File /r "@BUNDLE@\*"
  CreateDirectory "$SMPROGRAMS\@VENDOR@"
  CreateShortcut "$SMPROGRAMS\@VENDOR@\@DISPLAY_NAME@.lnk" "$INSTDIR\@EXECUTABLE@"
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  WriteRegStr HKCU "@UNINSTALL_KEY@" "DisplayName" "@DISPLAY_NAME@"
  WriteRegStr HKCU "@UNINSTALL_KEY@" "DisplayVersion" "@VERSION@"
  WriteRegStr HKCU "@UNINSTALL_KEY@" "Publisher" "@VENDOR@"
  WriteRegStr HKCU "@UNINSTALL_KEY@" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "@UNINSTALL_KEY@" "UninstallString" '$\"$INSTDIR\Uninstall.exe$\"'
  WriteRegStr HKCU "@UNINSTALL_KEY@" "QuietUninstallString" '$\"$INSTDIR\Uninstall.exe$\" /S'
  WriteRegDWORD HKCU "@UNINSTALL_KEY@" "NoModify" 1
  WriteRegDWORD HKCU "@UNINSTALL_KEY@" "NoRepair" 1
SectionEnd

; Removes only the files this installer wrote and the directories it emptied.
; A user-selected directory is never removed recursively.
Section "Uninstall"
@UNINSTALL_FILES@
@UNINSTALL_DIRECTORIES@
  Delete "$INSTDIR\Uninstall.exe"
  RMDir "$INSTDIR"
  Delete "$SMPROGRAMS\@VENDOR@\@DISPLAY_NAME@.lnk"
  RMDir "$SMPROGRAMS\@VENDOR@"
  DeleteRegKey HKCU "@UNINSTALL_KEY@"
SectionEnd
