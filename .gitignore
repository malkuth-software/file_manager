# Local filesystem metadata.
.DS_Store

# Per-platform compiler outputs, installed development SDKs and local receipts.
.build/

# Python build-tool bytecode is generated locally.
__pycache__/
*.pyc

# Local diagnostic output.
/gui_forms/backtrac*.txt
/gui_forms/crash.txt

# Fetched source repositories are reference material, not workspace contents.
/third_party/*/

# Disposable compiler objects restored from provider artifacts.
.ccache/
cache-manifest.json

# Written at the workspace root by the provider's CI tools: its state
# directory and the Windows toolchain archive it restores.
/.ci/
/gui-forms-toolchain-windows-x64.tar.zst
/gui-forms-toolchain-windows-x64.json

# The harness workspace (template_harness/docs/adopting.md, "root layout"):
# File Manager is the workspace root, so the pinned harness, the bootstrap's
# notes clones and the in-house projects clone sit inside this checkout.
/template_harness/
/notes/
/notes-*/
/projects/
